<http://example.org/ma#Collision-1-(8,3)> a ma:CollisionEvent ;
    ma:conflictLocation [ a ma:GridLocation ;
            ma:xCoordinate 8 ;
            ma:yCoordinate 3 ] ;
    ma:conflictTypeEvent "vertex" ;
    ma:involvesAgentsEvent ma:Robot-11,
        ma:Robot-18 ;
    ma:occursAtTime ma:time_instant_1 .

