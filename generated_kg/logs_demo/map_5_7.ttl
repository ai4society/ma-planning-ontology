@prefix : <http://example.org/ma-planning#> .
@prefix ma: <http://example.org/ma#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix plan: <https://ai4society.github.io/planning-ontology#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ma:FinalJointPlan a ma:JointPlan ;
    ma:composedOfSubPlans ma:Robot-1-Plan-Final,
        ma:Robot-2-Plan-Final,
        ma:Robot-3-Plan-Original,
        ma:Robot-4-Plan-Final,
        ma:Robot-5-Plan-Final ;
    ma:hasGlobalMakespan 21.0 .

ma:Robot-1-Plan-Resolved-1 a ma:ResolvedSubPlan ;
    ma:belongsToAgent ma:Robot-1 ;
    ma:derivesFrom ma:Robot-1-Plan-Original ;
    ma:generatedBy ma:Robot-1-Plan-Resolved-1_activity ;
    ma:hasPlanCost 23.0 ;
    ma:planData ma:Robot-1-Plan-Resolved-1_seg0,
        ma:Robot-1-Plan-Resolved-1_seg1,
        ma:Robot-1-Plan-Resolved-1_seg10,
        ma:Robot-1-Plan-Resolved-1_seg11,
        ma:Robot-1-Plan-Resolved-1_seg12,
        ma:Robot-1-Plan-Resolved-1_seg13,
        ma:Robot-1-Plan-Resolved-1_seg14,
        ma:Robot-1-Plan-Resolved-1_seg15,
        ma:Robot-1-Plan-Resolved-1_seg16,
        ma:Robot-1-Plan-Resolved-1_seg17,
        ma:Robot-1-Plan-Resolved-1_seg18,
        ma:Robot-1-Plan-Resolved-1_seg19,
        ma:Robot-1-Plan-Resolved-1_seg2,
        ma:Robot-1-Plan-Resolved-1_seg20,
        ma:Robot-1-Plan-Resolved-1_seg21,
        ma:Robot-1-Plan-Resolved-1_seg22,
        ma:Robot-1-Plan-Resolved-1_seg23,
        ma:Robot-1-Plan-Resolved-1_seg3,
        ma:Robot-1-Plan-Resolved-1_seg4,
        ma:Robot-1-Plan-Resolved-1_seg5,
        ma:Robot-1-Plan-Resolved-1_seg6,
        ma:Robot-1-Plan-Resolved-1_seg7,
        ma:Robot-1-Plan-Resolved-1_seg8,
        ma:Robot-1-Plan-Resolved-1_seg9 ;
    ma:resolvesConflict <http://example.org/ma#Collision-11-(1,6)> .

ma:Robot-2-Plan-Original a ma:OriginalSubPlan ;
    ma:belongsToAgent ma:Robot-2 ;
    ma:hasPlanCost 6.0 ;
